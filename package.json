{
  "name": "tech-offers-hub",
  "version": "1.0.0",
  "private": true,
  "description": "Webapp mobile che raccoglie giorno dopo giorno le offerte di PC fissi e notebook dai principali siti italiani di tecnologia.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "serve": "node pipeline/tools/serve.js",
    "collect": "node pipeline/run.js",
    "collect:seed": "node pipeline/run.js --seed-only",
    "seed": "node pipeline/seed/generate.js",
    "test": "node --test \"pipeline/test/*.test.js\"",
    "verify": "node pipeline/tools/smoke.js",
    "icons": "node pipeline/tools/icons.js",
    "bundle": "node pipeline/tools/bundle.js",
    "bundle:artifact": "node pipeline/tools/bundle.js --artifact"
  },
  "license": "MIT",
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
